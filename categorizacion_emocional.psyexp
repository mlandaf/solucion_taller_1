      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'id_p': 1, 'palabra_p': 'ALEGRÍA', 'emocion_p': 'alegria', 'tecla_correcta_p': 'f'}, {'id_p': 2, 'palabra_p': 'ALEGRÍA', 'emocion_p': 'alegria', 'tecla_correcta_p': 'f'}, {'id_p': 3, 'palabra_p': 'ALEGRÍA', 'emocion_p': 'alegria', 'tecla_correcta_p': 'f'}, {'id_p': 4, 'palabra_p': 'TRISTEZA', 'emocion_p': 'tristeza', 'tecla_correcta_p': 'g'}, {'id_p': 5, 'palabra_p': 'TRISTEZA', 'emocion_p': 'tristeza', 'tecla_correcta_p': 'g'}, {'id_p': 6, 'palabra_p': 'TRISTEZA', 'emocion_p': 'tristeza', 'tecla_correcta_p': 'g'}, {'id_p': 7, 'palabra_p': 'IRA', 'emocion_p': 'ira', 'tecla_correcta_p': 'h'}, {'id_p': 8, 'palabra_p': 'IRA', 'emocion_p': 'ira', 'tecla_correcta_p': 'h'}, {'id_p': 9, 'palabra_p': 'IRA', 'emocion_p': 'ira', 'tecla_correcta_p': 'h'}, {'id_p': 10, 'palabra_p': 'MIEDO', 'emocion_p': 'miedo', 'tecla_correcta_p': 'j'}, {'id_p': 11, 'palabra_p': 'MIEDO', 'emocion_p': 'miedo', 'tecla_correcta_p': 'j'}, {'id_p': 12, 'palabra_p': 'MIEDO', 'emocion_p': 'miedo', 'tecla_correcta_p': 'j'}]" valType="str"/>
